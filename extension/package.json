{
  "name": "luciole",
  "displayName": "Luciole",
  "description": "See a Python project as a 3D brain of functions, and watch it light up as the code runs.",
  "version": "0.1.0",
  "publisher": "pinepomme",
  "preview": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pinepomme/luciole"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Debuggers",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "luciole.showGraph",
        "title": "Show Graph (Whole Folder)",
        "category": "Luciole",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "luciole.showFileGraph",
        "title": "Show Graph for Current File",
        "category": "Luciole",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "luciole.runLive",
        "title": "Run Live",
        "category": "Luciole",
        "icon": "$(zap)"
      },
      {
        "command": "luciole.runLiveWith",
        "title": "Run Live…",
        "category": "Luciole",
        "icon": "$(run-all)"
      },
      {
        "command": "luciole.stopLive",
        "title": "Stop Live Run",
        "category": "Luciole",
        "icon": "$(debug-stop)",
        "enablement": "luciole.liveRunning"
      },
      {
        "command": "luciole.toggleAutoStart",
        "title": "Turn Auto-Start On or Off",
        "category": "Luciole",
        "icon": "$(zap)"
      }
    ],
    "configuration": {
      "title": "Luciole",
      "properties": {
        "luciole.autoStart": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Light up the Luciole view with every Python program (3.12+) started in VS Code's terminals: scripts, `pytest`, servers, and their child processes, run as usual. Applies to terminals opened afterwards. Also in the status bar."
        },
        "luciole.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter that runs the analyzer (3.10+) and live mode (3.12+). When empty, Luciole uses the workspace's .venv, then python3."
        },
        "luciole.runConfigurations": {
          "type": "array",
          "default": [],
          "markdownDescription": "Runs offered by **Luciole: Run Live…**. Each has a `name`, and either a `program` (script, relative to the workspace folder) or a `module` (run with `python -m`), plus optional `args`, `cwd` and `env`. `${workspaceFolder}` and `${file}` are replaced.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name shown in the picker."
              },
              "program": {
                "type": "string",
                "description": "Script to run, relative to the workspace folder."
              },
              "module": {
                "type": "string",
                "description": "Module to run with python -m, instead of program (pytest, mypkg.train…)."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory, relative to the workspace folder (default: the folder)."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables."
              }
            }
          }
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "luciole.runLive",
          "when": "editorLangId == python && !luciole.liveRunning",
          "group": "navigation@1"
        },
        {
          "command": "luciole.stopLive",
          "when": "luciole.liveRunning && !inDebugMode",
          "group": "navigation@1"
        },
        {
          "command": "luciole.showFileGraph",
          "when": "editorLangId == python",
          "group": "navigation@2"
        },
        {
          "command": "luciole.runLiveWith",
          "when": "editorLangId == python && !luciole.liveRunning",
          "group": "luciole@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "luciole.showGraph",
          "when": "resourceLangId == python"
        }
      ],
      "explorer/context": [
        {
          "command": "luciole.showGraph",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test out/test/",
    "screenshot": "node build.mjs && node out/dev/screenshot.js",
    "vscode:prepublish": "node build.mjs",
    "package": "node package.mjs",
    "install-local": "node package.mjs && code --install-extension luciole.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^18.19.34",
    "@types/three": "^0.186.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "3d-force-graph": "^1.80.1",
    "esbuild": "^0.20.2",
    "playwright-core": "^1.47.2",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "undici": "6.19.8"
  },
  "icon": "media/icon.png",
  "keywords": [
    "python",
    "call graph",
    "debugger",
    "visualization",
    "live",
    "tracing"
  ],
  "homepage": "https://github.com/Pinepomme/luciole",
  "bugs": {
    "url": "https://github.com/Pinepomme/luciole/issues"
  }
}
