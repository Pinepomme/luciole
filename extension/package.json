{
  "name": "luciole",
  "displayName": "Luciole",
  "description": "See a Python project as a 3D brain of functions, and watch it light up as the code runs.",
  "version": "0.2.0",
  "publisher": "pinepomme",
  "preview": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pinepomme/luciole"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Debuggers",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:luciole.actions",
    "onView:luciole.running",
    "onView:luciole.calls",
    "onView:luciole.map"
  ],
  "contributes": {
    "commands": [
      {
        "command": "luciole.showGraph",
        "title": "Show Graph (Whole Folder)",
        "category": "Luciole",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "luciole.showFileGraph",
        "title": "Show Graph for Current File",
        "category": "Luciole",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "luciole.runLive",
        "title": "Run Live",
        "category": "Luciole",
        "icon": "$(zap)"
      },
      {
        "command": "luciole.runLiveWith",
        "title": "Run Live…",
        "category": "Luciole",
        "icon": "$(run-all)"
      },
      {
        "command": "luciole.stopLive",
        "title": "Stop Live Run",
        "category": "Luciole",
        "icon": "$(debug-stop)",
        "enablement": "luciole.liveRunning"
      },
      {
        "command": "luciole.toggleAutoStart",
        "title": "Turn Auto-Start On or Off",
        "category": "Luciole",
        "icon": "$(zap)"
      },
      {
        "command": "luciole.findInMap",
        "title": "Find in Map",
        "category": "Luciole",
        "icon": "$(search)",
        "enablement": "luciole.graphOpen"
      },
      {
        "command": "luciole.revealInBrain",
        "title": "Show in Brain",
        "category": "Luciole",
        "icon": "$(eye)"
      },
      {
        "command": "luciole.goToSource",
        "title": "Go to Source",
        "category": "Luciole",
        "icon": "$(go-to-file)"
      },
      {
        "command": "luciole.stopProcess",
        "title": "Stop",
        "category": "Luciole",
        "icon": "$(debug-stop)"
      },
      {
        "command": "luciole.showCallStack",
        "title": "Show Call Stack",
        "category": "Luciole",
        "icon": "$(debug-alt)"
      },
      {
        "command": "luciole.clearExited",
        "title": "Clear Exited Processes",
        "category": "Luciole",
        "icon": "$(clear-all)"
      },
      {
        "command": "luciole.refreshCalls",
        "title": "Refresh Recorded Runs",
        "category": "Luciole",
        "icon": "$(refresh)"
      },
      {
        "command": "luciole.replay",
        "title": "Replay on the Brain",
        "category": "Luciole",
        "icon": "$(play)"
      },
      {
        "command": "luciole.showCall",
        "title": "Show Call",
        "category": "Luciole",
        "icon": "$(go-to-file)"
      },
      {
        "command": "luciole.showValues",
        "title": "Show Values",
        "category": "Luciole",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "luciole.loadMore",
        "title": "Load More Calls",
        "category": "Luciole"
      },
      {
        "command": "luciole.focusAround",
        "title": "Focus Around",
        "category": "Luciole",
        "icon": "$(target)",
        "enablement": "luciole.graphOpen"
      },
      {
        "command": "luciole.filters",
        "title": "Filters…",
        "category": "Luciole",
        "icon": "$(filter)",
        "enablement": "luciole.graphOpen"
      },
      {
        "command": "luciole.clearFilters",
        "title": "Clear Focus and Filters",
        "category": "Luciole",
        "icon": "$(clear-all)"
      },
      {
        "command": "luciole.whereFrom",
        "title": "Where Did This Value Come From?",
        "category": "Luciole",
        "icon": "$(references)"
      },
      {
        "command": "luciole.clearOrigin",
        "title": "Clear Origin",
        "category": "Luciole",
        "icon": "$(clear-all)"
      },
      {
        "command": "luciole.originStep",
        "title": "Show Step",
        "category": "Luciole"
      },
      {
        "command": "luciole.originContinue",
        "title": "Go On From Here",
        "category": "Luciole"
      },
      {
        "command": "luciole.originRerun",
        "title": "Record Line by Line and Run Again",
        "category": "Luciole",
        "icon": "$(debug-rerun)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "luciole",
          "title": "Luciole",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "luciole": [
        {
          "id": "luciole.actions",
          "name": "Actions",
          "icon": "media/activity.svg"
        },
        {
          "id": "luciole.running",
          "name": "Running",
          "icon": "media/activity.svg"
        },
        {
          "id": "luciole.calls",
          "name": "Calls",
          "icon": "media/activity.svg"
        },
        {
          "id": "luciole.origin",
          "name": "Origin",
          "icon": "media/activity.svg",
          "when": "luciole.hasOrigin"
        },
        {
          "id": "luciole.map",
          "name": "Map",
          "icon": "media/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "luciole.running",
        "contents": "No Python program is lit up right now.\n[Run Live](command:luciole.runLive)\nPrograms started in new terminals appear here too: auto-start is on.",
        "when": "config.luciole.autoStart"
      },
      {
        "view": "luciole.running",
        "contents": "No Python program is lit up right now.\n[Run Live](command:luciole.runLive)\nTurn [auto-start](command:luciole.toggleAutoStart) on to light up the programs you start in terminals too.",
        "when": "!config.luciole.autoStart"
      },
      {
        "view": "luciole.calls",
        "contents": "No recorded run yet. Every Run Live records what the program did: each call with its arguments and return value, and every exception. Runs an agent makes with luciole mcp show here too.\n[Run Live](command:luciole.runLive)",
        "when": "config.luciole.recordHistory"
      },
      {
        "view": "luciole.calls",
        "contents": "Recording is off (setting luciole.recordHistory): Run Live does not keep what the program did. Runs an agent makes with luciole mcp still show here.\n[Turn Recording On](command:workbench.action.openSettings?%22luciole.recordHistory%22)",
        "when": "!config.luciole.recordHistory"
      },
      {
        "view": "luciole.map",
        "contents": "No graph is open. The Map outlines the graph in the Luciole panel: packages, modules, classes and functions.\n[Show Graph for Current File](command:luciole.showFileGraph)\n[Show Graph (Whole Folder)](command:luciole.showGraph)",
        "when": "!luciole.graphOpen"
      }
    ],
    "configuration": {
      "title": "Luciole",
      "properties": {
        "luciole.autoStart": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Light up the Luciole view with every Python program (3.12+) started in VS Code's terminals: scripts, `pytest`, servers, and their child processes, run as usual. Applies to terminals opened afterwards. Also in the status bar."
        },
        "luciole.recordHistory": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Record every Run Live (level 1: each call of project code with its arguments and return value, and every exception) so the **Calls** view can show it afterwards and the brain can replay it. Recordings are kept in `~/.luciole/runs` (the last 50 per project), next to the runs agents make with `luciole mcp`, and never leave your machine. Needs Python 3.12+ in the program; with an older Python, nothing is recorded."
        },
        "luciole.focusDepth": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 5,
          "description": "Focus Around: how many calls away from the chosen function the brain still shows a function (callers and callees)."
        },
        "luciole.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter that runs the analyzer (3.10+) and live mode (3.12+). When empty, Luciole uses the workspace's .venv, then python3."
        },
        "luciole.runConfigurations": {
          "type": "array",
          "default": [],
          "markdownDescription": "Runs offered by **Luciole: Run Live…**. Each has a `name`, and either a `program` (script, relative to the workspace folder) or a `module` (run with `python -m`), plus optional `args`, `cwd` and `env`. `${workspaceFolder}` and `${file}` are replaced.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name shown in the picker."
              },
              "program": {
                "type": "string",
                "description": "Script to run, relative to the workspace folder."
              },
              "module": {
                "type": "string",
                "description": "Module to run with python -m, instead of program (pytest, mypkg.train…)."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory, relative to the workspace folder (default: the folder)."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables."
              }
            }
          }
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "luciole.runLive",
          "when": "editorLangId == python && !luciole.liveRunning",
          "group": "navigation@1"
        },
        {
          "command": "luciole.stopLive",
          "when": "luciole.liveRunning && !inDebugMode",
          "group": "navigation@1"
        },
        {
          "command": "luciole.showFileGraph",
          "when": "editorLangId == python",
          "group": "navigation@2"
        },
        {
          "command": "luciole.runLiveWith",
          "when": "editorLangId == python && !luciole.liveRunning",
          "group": "luciole@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "luciole.showGraph",
          "when": "resourceLangId == python"
        }
      ],
      "explorer/context": [
        {
          "command": "luciole.showGraph",
          "when": "explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "luciole.revealInBrain",
          "when": "false"
        },
        {
          "command": "luciole.goToSource",
          "when": "false"
        },
        {
          "command": "luciole.stopProcess",
          "when": "false"
        },
        {
          "command": "luciole.showCallStack",
          "when": "false"
        },
        {
          "command": "luciole.clearExited",
          "when": "luciole.exitedProcesses"
        },
        {
          "command": "luciole.showCall",
          "when": "false"
        },
        {
          "command": "luciole.showValues",
          "when": "false"
        },
        {
          "command": "luciole.loadMore",
          "when": "false"
        },
        {
          "command": "luciole.clearFilters",
          "when": "luciole.filtered"
        },
        {
          "command": "luciole.whereFrom",
          "when": "editorLangId == python && luciole.hasRuns"
        },
        {
          "command": "luciole.clearOrigin",
          "when": "luciole.hasOrigin"
        },
        {
          "command": "luciole.originStep",
          "when": "false"
        },
        {
          "command": "luciole.originContinue",
          "when": "false"
        },
        {
          "command": "luciole.originRerun",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "luciole.stopLive",
          "when": "view == luciole.running && luciole.liveRunning && !inDebugMode",
          "group": "navigation@1"
        },
        {
          "command": "luciole.clearExited",
          "when": "view == luciole.running && luciole.exitedProcesses",
          "group": "navigation@2"
        },
        {
          "command": "luciole.findInMap",
          "when": "view == luciole.map && luciole.graphOpen",
          "group": "navigation@1"
        },
        {
          "command": "luciole.replay",
          "when": "view == luciole.calls && luciole.hasRuns",
          "group": "navigation@1"
        },
        {
          "command": "luciole.refreshCalls",
          "when": "view == luciole.calls",
          "group": "navigation@2"
        },
        {
          "command": "luciole.filters",
          "when": "view == luciole.map && luciole.graphOpen",
          "group": "navigation@2"
        },
        {
          "command": "luciole.clearFilters",
          "when": "view == luciole.map && luciole.filtered",
          "group": "navigation@3"
        },
        {
          "command": "luciole.clearOrigin",
          "when": "view == luciole.origin",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "luciole.stopProcess",
          "when": "view == luciole.running && viewItem == process.stop",
          "group": "inline"
        },
        {
          "command": "luciole.showCallStack",
          "when": "view == luciole.running && viewItem == process.debug",
          "group": "inline"
        },
        {
          "command": "luciole.goToSource",
          "when": "view == luciole.map && viewItem == function",
          "group": "inline"
        },
        {
          "command": "luciole.revealInBrain",
          "when": "view == luciole.map",
          "group": "navigation@1"
        },
        {
          "command": "luciole.goToSource",
          "when": "view == luciole.map && viewItem == function",
          "group": "navigation@2"
        },
        {
          "command": "luciole.replay",
          "when": "view == luciole.calls && viewItem =~ /^(run|process)$/",
          "group": "inline"
        },
        {
          "command": "luciole.showValues",
          "when": "view == luciole.calls && viewItem =~ /^(call|where)$/",
          "group": "inline"
        },
        {
          "command": "luciole.replay",
          "when": "view == luciole.calls && viewItem =~ /^(run|process)$/",
          "group": "navigation@1"
        },
        {
          "command": "luciole.showCall",
          "when": "view == luciole.calls && viewItem =~ /^(call|where)$/",
          "group": "navigation@1"
        },
        {
          "command": "luciole.showValues",
          "when": "view == luciole.calls && viewItem =~ /^(call|where)$/",
          "group": "navigation@2"
        },
        {
          "command": "luciole.focusAround",
          "when": "view == luciole.calls && viewItem =~ /^(call|where)$/",
          "group": "navigation@3"
        },
        {
          "command": "luciole.focusAround",
          "when": "view == luciole.map && viewItem == function",
          "group": "navigation@3"
        },
        {
          "command": "luciole.whereFrom",
          "when": "view == luciole.calls && viewItem == value.origin",
          "group": "inline"
        },
        {
          "command": "luciole.whereFrom",
          "when": "view == luciole.calls && viewItem =~ /^(call|where|value\\.origin)$/",
          "group": "navigation@4"
        },
        {
          "command": "luciole.originRerun",
          "when": "view == luciole.origin && viewItem == origin.rerun",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "luciole.whereFrom",
          "when": "editorLangId == python && luciole.hasRuns",
          "group": "luciole@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test out/test/",
    "screenshot": "node build.mjs && node out/dev/screenshot.js",
    "vscode:prepublish": "node build.mjs",
    "package": "node package.mjs",
    "install-local": "node package.mjs && code --install-extension luciole.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^18.19.34",
    "@types/three": "^0.186.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "3d-force-graph": "^1.80.1",
    "esbuild": "^0.20.2",
    "playwright-core": "^1.47.2",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "undici": "6.19.8"
  },
  "icon": "media/icon.png",
  "keywords": [
    "python",
    "call graph",
    "debugger",
    "visualization",
    "live",
    "tracing"
  ],
  "homepage": "https://github.com/Pinepomme/luciole",
  "bugs": {
    "url": "https://github.com/Pinepomme/luciole/issues"
  }
}
